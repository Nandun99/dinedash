# Copy to .env and fill in real values. Never commit .env.

# --- Databases ---
MONGO_ROOT_USER=dinedash
MONGO_ROOT_PASSWORD=change-me
ORACLE_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
MSSQL_SA_PASSWORD=Change-me-123!

# --- Security ---
# Base64 encoded 256-bit key, e.g. `openssl rand -base64 32`
JWT_SECRET=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AWS ---
AWS_REGION=ap-south-1
S3_BUCKET=dinedash-media

# --- Firebase ---
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase.json

# --- Bootstrap admin (auth-user-service) ---
ADMIN_EMAIL=admin@dinedash.lk
ADMIN_PASSWORD=change-me

# Firebase live tracking (delivery-service) and push (notification-service)
FIREBASE_ENABLED=false
