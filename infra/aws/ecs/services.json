{
  "api-gateway": {
    "port": 8080,
    "cpu": 512,
    "memory": 1024,
    "taskRole": "dinedash-default-task",
    "environment": {
      "AUTH_SERVICE_URL": "http://auth-user-service:8081",
      "RESTAURANT_SERVICE_URL": "http://restaurant-service:8082",
      "ORDER_SERVICE_URL": "http://order-service:8083",
      "PAYMENT_SERVICE_URL": "http://payment-service:8084",
      "DELIVERY_SERVICE_URL": "http://delivery-service:8085",
      "NOTIFICATION_SERVICE_URL": "http://notification-service:8086",
      "CORS_ALLOWED_ORIGINS": "https://dinedash.example.com"
    },
    "secrets": [
      "JWT_SECRET"
    ]
  },
  "auth-user-service": {
    "port": 8081,
    "cpu": 512,
    "memory": 1024,
    "taskRole": "dinedash-default-task",
    "environment": {},
    "secrets": [
      "JWT_SECRET",
      "MSSQL_HOST",
      "MSSQL_SA_PASSWORD",
      "ADMIN_EMAIL",
      "ADMIN_PASSWORD"
    ]
  },
  "restaurant-service": {
    "port": 8082,
    "cpu": 512,
    "memory": 1024,
    "taskRole": "dinedash-restaurant-task",
    "environment": {
      "AWS_REGION": "ap-south-1",
      "S3_BUCKET": "dinedash-media"
    },
    "secrets": [
      "RESTAURANT_MONGO_URI:MONGO_URI",
      "KAFKA_BOOTSTRAP_SERVERS",
      "REDIS_HOST"
    ]
  },
  "order-service": {
    "port": 8083,
    "cpu": 512,
    "memory": 1024,
    "taskRole": "dinedash-default-task",
    "environment": {
      "RESTAURANT_SERVICE_URL": "http://restaurant-service:8082"
    },
    "secrets": [
      "ORACLE_HOST",
      "ORDER_DB_PASSWORD",
      "KAFKA_BOOTSTRAP_SERVERS"
    ]
  },
  "payment-service": {
    "port": 8084,
    "cpu": 512,
    "memory": 1024,
    "taskRole": "dinedash-default-task",
    "environment": {},
    "secrets": [
      "ORACLE_HOST",
      "PAYMENT_DB_PASSWORD",
      "KAFKA_BOOTSTRAP_SERVERS",
      "STRIPE_SECRET_KEY",
      "STRIPE_PUBLISHABLE_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ]
  },
  "delivery-service": {
    "port": 8085,
    "cpu": 256,
    "memory": 768,
    "taskRole": "dinedash-default-task",
    "environment": {
      "FIREBASE_ENABLED": "true"
    },
    "secrets": [
      "DELIVERY_MONGO_URI:MONGO_URI",
      "KAFKA_BOOTSTRAP_SERVERS",
      "FIREBASE_DATABASE_URL",
      "FIREBASE_CREDENTIALS_JSON"
    ]
  },
  "notification-service": {
    "port": 8086,
    "cpu": 256,
    "memory": 768,
    "taskRole": "dinedash-default-task",
    "environment": {
      "FIREBASE_ENABLED": "true",
      "APP_BASE_URL": "https://dinedash.example.com"
    },
    "secrets": [
      "NOTIFICATION_MONGO_URI:MONGO_URI",
      "KAFKA_BOOTSTRAP_SERVERS",
      "FIREBASE_CREDENTIALS_JSON"
    ]
  },
  "frontend": {
    "port": 80,
    "cpu": 256,
    "memory": 512,
    "taskRole": "dinedash-default-task",
    "environment": {
      "API_UPSTREAM": "http://api-gateway:8080"
    },
    "secrets": []
  }
}
